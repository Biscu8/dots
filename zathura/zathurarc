set selection-clipboard clipboard

# ==========================================
# Colors
# ==========================================

# Main background
set default-bg rgba(25,28,35,0.95)
set default-fg "#EBEEF3"

# Status bar
set statusbar-bg "#242836"
set statusbar-fg "#A6ABB6"

# Input bar
set inputbar-bg "#242836"
set inputbar-fg "#59EEF5"

# Completion menu
set completion-bg "#242836"
set completion-fg "#EBEEF3"
set completion-group-bg "#3A4459"
set completion-group-fg "#A6ABB6"
set completion-highlight-bg "#59EEF5"
set completion-highlight-fg "#191C23"

# Notifications
set notification-bg "#242836"
set notification-fg "#EBEEF3"
set notification-error-bg "#F263EE"
set notification-error-fg "#191C23"
set notification-warning-bg "#FAF289"
set notification-warning-fg "#191C23"

# Loading indicator
set render-loading-bg "#242836"
set render-loading-fg "#59EEF5"

# Selection
set highlight-color "#F263EE"
set highlight-active-color "#59EEF5"

# Recoloring
set recolor true
set recolor-darkcolor "#EBEEF3"
set recolor-lightcolor "#191C23"
set recolor-keephue true
